{
  "compilerOptions": {
    "target": "ES2022", "useDefineForClassFields": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true, "resolveJsonModule": true,
    "strict": true, "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true, "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true, "isolatedModules": true, "noEmit": true,
    "skipLibCheck": true, "jsx": "react-jsx", "types": ["vite/client", "node"]
  },
  "include": ["src", "performance/**/*.ts", "scripts", "tests", "*.config.ts"]
}
